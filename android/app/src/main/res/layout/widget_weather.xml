<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/w_place" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:ellipsize="end" android:maxLines="1" android:text="Local Weather" android:textColor="@color/widget_muted" android:textSize="13sp" />
        <TextView android:id="@+id/w_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-light"
            android:includeFontPadding="false" android:text="–" android:textColor="@color/widget_fg" android:textSize="42sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2"
                android:text="Loading weather…" android:textColor="@color/widget_fg" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_hilo" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1"
                android:textColor="@color/widget_muted" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/w_hours" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:orientation="horizontal" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/h0_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="11sp" />
            <TextView android:id="@+id/h0_c" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_fg" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/h0_p" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_rain" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/h1_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="11sp" />
            <TextView android:id="@+id/h1_c" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_fg" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/h1_p" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_rain" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/h2_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="11sp" />
            <TextView android:id="@+id/h2_c" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_fg" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/h2_p" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_rain" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/h3_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="11sp" />
            <TextView android:id="@+id/h3_c" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_fg" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/h3_p" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_rain" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/h4_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="11sp" />
            <TextView android:id="@+id/h4_c" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_fg" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/h4_p" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_rain" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/w_sky" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="12sp" />
</LinearLayout>
