<?xml version="1.0" encoding="utf-8"?>
<!-- Sections are separated by weighted spacers so the content spreads evenly over whatever height the widget has. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_night_clear"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/w_place" style="@style/WText.Dim" android:layout_width="0dp" android:layout_weight="1"
            android:ellipsize="end" android:text="Sunnyloha" android:textSize="13sp" />
        <TextView android:id="@+id/w_updated" style="@style/WText.Dim" android:layout_marginStart="8dp" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/w_temp" style="@style/WText" android:fontFamily="sans-serif-light"
            android:includeFontPadding="false" android:text="–" android:textSize="42sp" />
        <TextView android:id="@+id/w_icon" style="@style/WText" android:layout_marginStart="8dp" android:textSize="28sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_desc" style="@style/WText" android:layout_width="match_parent" android:ellipsize="end" android:maxLines="2"
                android:text="Loading weather…" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_hilo" style="@style/WText.Dim" android:layout_width="match_parent" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/w_air" style="@style/WText" android:layout_width="match_parent" android:layout_marginTop="4dp"
        android:ellipsize="end" android:textSize="12sp" android:visibility="gone" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <LinearLayout android:id="@+id/w_hours" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/h0_t" style="@style/WText.Dim" android:textSize="11sp" />
            <TextView android:id="@+id/h0_c" style="@style/WText" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/h0_p" style="@style/WText" android:textColor="@color/widget_rain" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/h1_t" style="@style/WText.Dim" android:textSize="11sp" />
            <TextView android:id="@+id/h1_c" style="@style/WText" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/h1_p" style="@style/WText" android:textColor="@color/widget_rain" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/h2_t" style="@style/WText.Dim" android:textSize="11sp" />
            <TextView android:id="@+id/h2_c" style="@style/WText" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/h2_p" style="@style/WText" android:textColor="@color/widget_rain" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/h3_t" style="@style/WText.Dim" android:textSize="11sp" />
            <TextView android:id="@+id/h3_c" style="@style/WText" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/h3_p" style="@style/WText" android:textColor="@color/widget_rain" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/h4_t" style="@style/WText.Dim" android:textSize="11sp" />
            <TextView android:id="@+id/h4_c" style="@style/WText" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/h4_p" style="@style/WText" android:textColor="@color/widget_rain" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <LinearLayout android:id="@+id/w_days" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/widget_chip"
        android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
        <TextView android:id="@+id/d0" style="@style/WText" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:textSize="12sp" />
        <TextView android:id="@+id/d1" style="@style/WText" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:textSize="12sp" />
        <TextView android:id="@+id/d2" style="@style/WText" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:textSize="12sp" />
    </LinearLayout>

    <TextView android:id="@+id/w_music" style="@style/WText" android:layout_width="match_parent" android:layout_marginTop="6dp"
        android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_music" android:textSize="12sp" android:visibility="gone" />

    <TextView android:id="@+id/w_note" style="@style/WText" android:layout_width="match_parent" android:layout_marginTop="6dp"
        android:ellipsize="end" android:textColor="@color/widget_note" android:textSize="12sp" android:visibility="gone" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <TextView android:id="@+id/w_sky" style="@style/WText.Dim" android:layout_width="match_parent" android:ellipsize="end" android:textSize="12sp" />
</LinearLayout>
